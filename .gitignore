# Foundry
cache/
out/
broadcast/*/**/dry-run/
# local anvil runs — noise, and deployments/31337.json has the addresses
broadcast/*/31337/

# Env — never commit secrets
.env
.env.*
!.env.example

# Node / Next.js
node_modules/
web/.next/
web/out/

# Editor/OS
.DS_Store
.vscode/
.idea/
.vercel
art-out/

# Local tooling config — machine-specific, and .claude/settings.local.json
# holds per-machine permissions nobody else can use. web/AGENTS.md is
# regenerated by `next dev` on every run, so it has to be ignored rather
# than deleted or it comes back as a dirty file every time.
.claude/
web/AGENTS.md
web/CLAUDE.md
