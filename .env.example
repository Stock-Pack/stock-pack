# Contracts-side environment (Foundry). Copy to .env — .env is gitignored.
# Public RPCs are rate-limited; use an Alchemy/QuickNode URL for anything heavy.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Blockscout verification (robinhoodchain.blockscout.com — Etherscan does NOT support chain 4663)
BLOCKSCOUT_MAINNET_API=https://robinhoodchain.blockscout.com/api/
BLOCKSCOUT_TESTNET_API=https://explorer.testnet.chain.robinhood.com/api/

# Deployer: use an encrypted keystore, never a plaintext key:
#   cast wallet import stockpack-deployer --interactive
# then deploy with: forge script ... --account stockpack-deployer
