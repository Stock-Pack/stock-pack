# ── network ──────────────────────────────────────────────────────────────────
# local (anvil 31337) | testnet (Robinhood 46630) | mainnet (Robinhood 4663)
NEXT_PUBLIC_CHAIN=local

# WalletConnect / Reown Cloud project id — create one at https://cloud.reown.com
# (injected wallets work without it in dev; WalletConnect QR needs a real id)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC overrides. Public Robinhood RPCs are rate-limited — use Alchemy for production:
#   https://robinhood-mainnet.g.alchemy.com/v2/<KEY> / robinhood-testnet
NEXT_PUBLIC_RPC_URL=
RPC_URL=

# Optional: override the escrow address (otherwise lib/deployments/<chainId>.json)
NEXT_PUBLIC_STOCKPACK_ADDRESS=

# ── MongoDB (query index; chain-scan fallback used when unset) ───────────────
MONGODB_URI=
MONGODB_DB=stockpack

# ── server-only secrets ──────────────────────────────────────────────────────
# REQUIRED for /api/sync — the endpoint fails closed (503) without it. Vercel
# cron sends it automatically as `Authorization: Bearer <CRON_SECRET>` when the
# env var is set on the project. Header-only; generate with `openssl rand -hex 32`.
CRON_SECRET=
# OpenSea metadata-refresh proxy (mainnet only) — NEVER expose client-side
OPENSEA_API_KEY=

# ── real tokenized stocks (mainnet) ──────────────────────────────────────────
# HARD GATE: leave false until legal review + geofencing are in place. Robinhood
# Stock Tokens are debt securities restricted from US/UK/CA/CH/UAE persons.
NEXT_PUBLIC_ENABLE_REAL_TOKENS=false
